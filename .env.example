# Server
PORT=3000
NODE_ENV=development

# ตั้งชื่อผู้ใช้และรหัสผ่านใหม่ก่อนใช้งานจริง
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ที่เก็บฐานข้อมูล SQLite
DB_PATH=./data/leads.db

# ไม่บังคับ: ส่งข้อมูลลูกค้าไปยัง Webhook ของ Make, Zapier หรือระบบอื่น
# LEAD_WEBHOOK_URL=https://example.com/your-webhook
